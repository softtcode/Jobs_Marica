# O mapa usa OpenStreetMap/Leaflet: NÃO precisa de chave de API.

# Opcional: outra fonte de tiles (ex.: provedor com plano gratuito) caso o tráfego do app
# passe a ser alto. O tile server público do OSM não é pensado para uso intensivo.
# Formato padrão do Leaflet, com {z}/{x}/{y}.
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Atribuição exibida no mapa. Ao trocar o provedor, use o texto exigido por ele.
VITE_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">OpenStreetMap</a> contributors

# Em produção com frontend e backend em domínios diferentes, informe a URL da API.
# Deixe vazio para usar o proxy do Vite (dev) ou o mesmo domínio (produção unificada).
VITE_API_URL=
